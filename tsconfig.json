{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "esnext",

    "lib": ["esnext"],
    "types": ["node", "jest"],
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@config/*": ["./src/config/*"],
      "@shared/*": ["./src/shared/*"],
      "@errors/*": ["./src/errors/*"],
      "@utils/*":["./src/utils/*"]
    },

    "strict": true,
    "esModuleInterop": true,
    // "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    /* Experimental Options */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "skipLibCheck": true
  }
}
